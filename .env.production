# Public, non-secret build config for production builds (`pnpm build`).
# Committed on purpose: clean-folder builds (`git archive HEAD`) and CI both get
# these values without copying `.env`. Real secrets stay in `.env` (gitignored).
# A shell env var with the same name overrides a value here.

# Google AdSense publisher ID. Already public in public/ads.txt and the
# google-adsense-account meta tag. Empty = no ad script, no ad slots.
VITE_ADSENSE_ID=ca-pub-7739329133284929

# Mac App Store app ID. Keep EMPTY until Apple approves the app: an empty value
# hides every download button. Approved app ID: 6760172007.
VITE_APP_STORE_ID=
